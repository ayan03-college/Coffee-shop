# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coffee-shop?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRE=7d

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) - invite-only in India, optional
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys) - works self-serve in India
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI Barista (optional) - powers the /api/ai/barista chat assistant using Google Gemini (free tier)
# Get a key from https://aistudio.google.com/apikey - feature auto-disables if left blank
GEMINI_API_KEY=

# Admin bootstrap (used only by seed script)
ADMIN_EMAIL=admin@coffeeshop.com
ADMIN_PASSWORD=Admin@12345
